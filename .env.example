# ============================================================
# SARA AI
# Environment Configuration
# ============================================================

# Telegram
BOT_TOKEN=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=

# Database
# Development:
DATABASE_URL=sqlite+aiosqlite:///./data/sara.db

# Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/sara

# Administration
ADMIN_IDS=

# Timezone
TIMEZONE=Asia/Tashkent

# Features
MEMORY_ENABLED=true
PROACTIVE_GROUP_MODE=true
REMINDER_ENABLED=true
BOT_TO_BOT_MODE=true
MEDIA_ENABLED=true

# Memory
MAX_RECENT_MESSAGES=100
MAX_MEMORY_RESULTS=15
MAX_CONTEXT_TOKENS=12000

# Proactive AI
PROACTIVE_COOLDOWN_SECONDS=300
QUIET_GROUP_INTERVAL_SECONDS=3600

# Bot-to-bot protection
MAX_BOT_CHAIN=5
BOT_TO_BOT_COOLDOWN_SECONDS=30

# Rate limits
USER_RATE_LIMIT_SECONDS=1
GROUP_RATE_LIMIT_SECONDS=1

# Logging
LOG_LEVEL=INFO
